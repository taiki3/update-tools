#Requires -Version 5.1
# UpdateTools installer. Generated by Build-Installer.ps1.
# Run in a child scope so irm | iex does not change caller preferences or exit the shell.
& {
    [CmdletBinding(SupportsShouldProcess)]
    param(
        [string]$InstallDir = (Join-Path $env:LOCALAPPDATA 'UpdateTools\bin'),
        [switch]$NoPath
    )
    $ErrorActionPreference = 'Stop'
    $version = '__VERSION__'
    $payload = @'
__PAYLOAD__
'@ | ConvertFrom-Json
    $InstallDir = [IO.Path]::GetFullPath($InstallDir)
    if (!$PSCmdlet.ShouldProcess($InstallDir, "Install UpdateTools $version and add to user PATH")) { return }

    # Decode and verify every file before changing the installation.
    $decoded = @{}
    foreach ($file in $payload) {
        if ($file.Name -notin @('Update-Tools.ps1', 'update-tools.cmd')) { throw 'Unexpected package file name.' }
        $bytes = [Convert]::FromBase64String($file.Content)
        $sha256 = [Security.Cryptography.SHA256]::Create()
        try { $hash = [BitConverter]::ToString($sha256.ComputeHash($bytes)).Replace('-', '') }
        finally { $sha256.Dispose() }
        if ($hash -ne $file.Sha256) { throw "Checksum mismatch: $($file.Name)" }
        $decoded[$file.Name] = $bytes
    }
    $decoded['VERSION'] = [Text.Encoding]::ASCII.GetBytes($version)
    $decoded['INSTALLATION.json'] = [Text.Encoding]::ASCII.GetBytes('{"Application":"UpdateTools"}')
    [IO.Directory]::CreateDirectory($InstallDir) | Out-Null
    $backups = @{}
    $written = New-Object 'Collections.Generic.List[string]'
    try {
        foreach ($name in @('Update-Tools.ps1', 'update-tools.cmd', 'INSTALLATION.json', 'VERSION')) {
            $path = Join-Path $InstallDir $name
            $backups[$name] = $null
            if ([IO.File]::Exists($path)) {
                $backups[$name] = [IO.File]::ReadAllBytes($path)
                # The cmd launcher may currently be running. Never rewrite unchanged files.
                if ([Convert]::ToBase64String($backups[$name]) -ceq [Convert]::ToBase64String($decoded[$name])) { continue }
            }
            $written.Add($name)
            [IO.File]::WriteAllBytes($path, $decoded[$name])
        }
    } catch {
        foreach ($name in $written) {
            $path = Join-Path $InstallDir $name
            if ($null -ne $backups[$name]) { [IO.File]::WriteAllBytes($path, $backups[$name]) }
            elseif ([IO.File]::Exists($path)) { [IO.File]::Delete($path) }
        }
        throw
    }

    if (!$NoPath) {
        $userPath = [Environment]::GetEnvironmentVariable('Path', 'User')
        $entries = @($userPath -split ';' | Where-Object { $_ })
        $normalized = @($entries | ForEach-Object { [Environment]::ExpandEnvironmentVariables($_).TrimEnd('\') })
        if ($normalized -notcontains $InstallDir.TrimEnd('\')) {
            $newPath = (@($entries) + $InstallDir) -join ';'
            [Environment]::SetEnvironmentVariable('Path', $newPath, 'User')
        }
        $currentEntries = @($env:PATH -split ';' | ForEach-Object { $_.TrimEnd('\') })
        if ($currentEntries -notcontains $InstallDir.TrimEnd('\')) {
            $env:PATH = $env:PATH.TrimEnd(';') + ';' + $InstallDir
        }
    }
    Write-Host "Installed UpdateTools $version to $InstallDir" -ForegroundColor Green
    Write-Host 'Run: update-tools'
    Write-Host 'Preview: update-tools -WhatIf'
} @args
